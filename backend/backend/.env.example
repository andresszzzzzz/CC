# Servidor
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/easynotes

# Autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Seed inicial (ver src/seed/seedInicial.js) — solo se usan al ejecutar "npm run seed"
NUCLEO_NOMBRE=Nucleo Educativo Barichara
NUCLEO_CODIGO=NUC-001
NUCLEO_MUNICIPIO=Barichara
NUCLEO_DEPARTAMENTO=Santander
ADMIN_NOMBRES=Admin
ADMIN_APELLIDOS=Nucleo
ADMIN_EMAIL=admin@nucleo.edu.co
ADMIN_USUARIO=admin.nucleo
ADMIN_PASSWORD=CambiaEstaClave123

# Recuperación de contraseña
# URL pública del frontend (el enlace del correo apunta a FRONTEND_URL/restablecer-password?token=...)
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=60

# Correo (SMTP). Si SMTP_HOST queda vacío, en desarrollo el enlace se imprime en la consola del servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
MAIL_FROM="EasyNotes <tu_correo@gmail.com>"
